# Copy to .env (gitignored) and fill in. Used by the Vite dev-server proxy
# for the GitHub contributions heatmap (Task 2.8). NO "VITE_" prefix — this
# token must stay server-side and never be inlined into the client bundle.

# A GitHub personal access token with read-only "read:user" scope.
# Create one at: https://github.com/settings/tokens
GITHUB_TOKEN=
